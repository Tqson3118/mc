# ==============================================================================
# XÂY DỰNG QUẦY & TRIỆU HỒI NPC TIẾN HÓA CỔ ĐẠI (ANCIENT EVOLUTION NPCS)
# Vị trí: Khu vực Trung Tâm Phía Bắc Spawn (Z=-5 đến Z=-7, X=-6 đến X=6)
# ==============================================================================

# 1. Dọn dẹp NPC Tiến Hóa Cổ Đại cũ nếu có
kill @e[type=villager,tag=ancient_evolution_npc]

# 2. XÂY DỰNG KIẾN TRÚC ĐIỆN THẦN RÈN CỔ ĐẠI & LUYỆN KIM (Y=120..124)
# Nền móng khu vực
fill -7 120 -8 7 120 -4 polished_blackstone_bricks
fill -6 120 -7 6 120 -5 gilded_blackstone

# --- QUẦY 1: ĐẠI SƯ LUYỆN KIM (Tây: X=-5, Z=-6) ---
fill -7 121 -7 -3 121 -7 spruce_trapdoor[facing=north,open=true]
fill -7 121 -5 -3 121 -5 spruce_trapdoor[facing=south,open=true]
setblock -7 121 -6 blast_furnace
setblock -3 121 -6 brewing_stand
fill -7 124 -7 -3 124 -5 purple_wool
setblock -5 123 -6 soul_lantern[hanging=true]
setblock -5 122 -5 oak_wall_sign[facing=south]{front_text:{has_glowing_text:1b,messages:['{"text":"[ ĐẠI SƯ LUYỆN KIM ]","color":"light_purple","bold":true}','{"text":"Luyện Quặng & Tinh Thể","color":"aqua"}','{"text":"Đổi Sắt, Vàng, Kim Cương","color":"yellow"}','{"text":"Lõi Hư Không & Tinh Hoa","color":"gold"}']}}

# --- QUẦY 2: THẦN RÈN CÚP & RÌU (Trung tâm: X=0, Z=-6) ---
fill -2 121 -7 2 121 -7 spruce_trapdoor[facing=north,open=true]
fill -2 121 -5 2 121 -5 spruce_trapdoor[facing=south,open=true]
setblock -2 121 -6 smithing_table
setblock 2 121 -6 anvil
fill -2 124 -7 2 124 -5 orange_wool
setblock 0 124 -6 yellow_wool
setblock 0 123 -6 soul_lantern[hanging=true]
setblock 0 122 -5 oak_wall_sign[facing=south]{front_text:{has_glowing_text:1b,messages:['{"text":"[ THẦN RÈN CÚP & RÌU ]","color":"gold","bold":true}','{"text":"Tiến Hóa Cúp & Rìu 15T","color":"yellow"}','{"text":"Tier 10: ĐÀO NỔ 3x3!","color":"red","bold":true}','{"text":"Tier 15: SÁNG THẾ VŨ TRỤ","color":"aqua"}']}}

# --- QUẦY 3: THẦN RÈN VŨ KHÍ & GIÁP (Đông: X=5, Z=-6) ---
fill 3 121 -7 7 121 -7 spruce_trapdoor[facing=north,open=true]
fill 3 121 -5 7 121 -5 spruce_trapdoor[facing=south,open=true]
setblock 3 121 -6 grindstone[facing=east]
setblock 7 121 -6 smithing_table
fill 3 124 -7 7 124 -5 red_wool
setblock 5 123 -6 soul_lantern[hanging=true]
setblock 5 122 -5 oak_wall_sign[facing=south]{front_text:{has_glowing_text:1b,messages:['{"text":"[ THẦN RÈN VŨ KHÍ ]","color":"red","bold":true}','{"text":"Kiếm, Giáp & Cung 15T","color":"gold"}','{"text":"Tier 10: HÚT MÁU & SẤM!","color":"aqua","bold":true}','{"text":"Tier 15: BẤT TỬ & FLY!","color":"yellow","bold":true}']}}

